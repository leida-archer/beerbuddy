# BeerBuddy environment variables — copy this file to .env.local and fill in.
# .env.local is gitignored.

# Postgres connection string from Neon (https://console.neon.tech)
# Format: postgres://user:password@host/db?sslmode=require
DATABASE_URL=

# Anthropic API key (for Haiku circular parsing)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Static admin password — protects /admin/indie and /admin/aliases
# (See DESIGN.md § Product Principle: Zero User Labor — admin form
# is never linked publicly; this is dev-only.)
ADMIN_PASSWORD=
