# BeerBuddy environment variables — copy this file to .env.local and fill in.
# .env.local is gitignored.

# Postgres connection string from Neon (https://console.neon.tech)
# Format: postgres://user:password@host/db?sslmode=require
DATABASE_URL=

# Static admin password — protects /admin/indie, /admin/aliases, and
# /admin/parse-queue (See DESIGN.md § Product Principle: Zero User
# Labor — admin pages are never linked publicly; this is dev-only.)
ADMIN_PASSWORD=

# Optional — admin notification side channels. Both unset → notifications
# are console-only (always written) + durable rows in the manual_parse_queue
# table. Set to enable active push when an adapter flags a source for
# manual handling.
#
#   RESEND_API_KEY: Resend (resend.com) API key for transactional email
#   ADMIN_EMAIL:    where parse-queue notifications get sent
RESEND_API_KEY=
ADMIN_EMAIL=
